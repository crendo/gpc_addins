<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conduit Capacity Visualizer" 
        Height="490" Width="440" 
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        ResizeMode="NoResize"
        Topmost="True">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Info -->
            <RowDefinition Height="Auto"/> <!-- Sizing Method Dropdown -->
            <RowDefinition Height="*"/>    <!-- Stats / Live Legend -->
            <RowDefinition Height="Auto"/> <!-- Line Weight Slider -->
            <RowDefinition Height="Auto"/> <!-- Buttons Row -->
        </Grid.RowDefinitions>

        <!-- 1. Header Area -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Conduit Capacity Visualizer" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Apply dynamic, color-coded graphic overrides based on conduit capacity in the active view." FontSize="11" Foreground="#64748B" Margin="0,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 2. Sizing Method Selection -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Sizing Method:" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" x:Name="cbSizingMethod" Height="32" Padding="8,4" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" SelectedIndex="0" SelectionChanged="SizingMethod_Changed">
                    <ComboBoxItem Content="NEC Capacity Limit (Code)"/>
                    <ComboBoxItem Content="Direct Fill Ratio (Raw Area)"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- 3. Legend & Live Counts Card -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="CONDUIT ANALYSIS SUMMARY" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,12"/>
                
                <!-- Total Count Label -->
                <TextBlock DockPanel.Dock="Bottom" x:Name="lblTotalConduits" Text="Total Conduits Found in View: 0" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                
                <StackPanel VerticalAlignment="Center">
                    <!-- Scale 1: Green -->
                    <Border Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="12" Height="12" Fill="#10B981" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Safe / Underutilized" FontWeight="SemiBold" Foreground="#14532D" FontSize="13"/>
                                <TextBlock x:Name="lblScale1Range" Text="0% - 40% of allowed NEC limit" Foreground="#166534" FontSize="10"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" x:Name="lblScale1Count" Text="0 Conduits" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Scale 2: Lime -->
                    <Border Background="#F7FEE7" BorderBrush="#ECFCCB" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="12" Height="12" Fill="#84CC16" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Moderate Fill" FontWeight="SemiBold" Foreground="#365314" FontSize="13"/>
                                <TextBlock x:Name="lblScale2Range" Text="40% - 80% of allowed NEC limit" Foreground="#3F6212" FontSize="10"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" x:Name="lblScale2Count" Text="0 Conduits" FontWeight="Bold" Foreground="#4D7C0F" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Scale 3: Amber -->
                    <Border Background="#FFFBEB" BorderBrush="#FEF3C7" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="12" Height="12" Fill="#F59E0B" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Approaching Limit" FontWeight="SemiBold" Foreground="#78350F" FontSize="13"/>
                                <TextBlock x:Name="lblScale3Range" Text="80% - 100% of allowed NEC limit" Foreground="#92400E" FontSize="10"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" x:Name="lblScale3Count" Text="0 Conduits" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Scale 4: Red -->
                    <Border Background="#FEF2F2" BorderBrush="#FEE2E2" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="12" Height="12" Fill="#EF4444" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Over Capacity / Code Violation" FontWeight="SemiBold" Foreground="#7F1D1D" FontSize="13"/>
                                <TextBlock x:Name="lblScale4Range" Text=">100% of allowed NEC limit" Foreground="#991B1B" FontSize="10"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" x:Name="lblScale4Count" Text="0 Conduits" FontWeight="Bold" Foreground="#B91C1C" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 4. Line Weight Slider -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Line Weight (1-16):" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                <DockPanel Grid.Column="1">
                    <TextBlock x:Name="lblWeightVal" Text="6" Width="25" TextAlignment="Right" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="10,0,0,0"/>
                    <Slider x:Name="sliderWeight" Minimum="1" Maximum="16" Value="6" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="SliderWeight_Changed"/>
                </DockPanel>
            </Grid>
        </Border>

        <!-- 5. Interactive Action Buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Button Grid.Column="0" Content="Clear Highlights" Click="Clear_Click" Width="110" Height="34" Background="#F1F5F9" Foreground="#475569" BorderBrush="#E2E8F0" FontWeight="SemiBold"/>
            <Button Grid.Column="2" Content="Close" Click="Close_Click" Width="80" Height="34" Margin="0,0,8,0" Background="#F8FAFC" Foreground="#64748B" BorderBrush="#E2E8F0" FontWeight="SemiBold"/>
            <Button Grid.Column="3" Content="Apply Overrides" Click="Apply_Click" Width="130" Height="34" Background="#10B981" Foreground="White" BorderBrush="{x:Null}" FontWeight="SemiBold"/>
        </Grid>
    </Grid>
</Window>
