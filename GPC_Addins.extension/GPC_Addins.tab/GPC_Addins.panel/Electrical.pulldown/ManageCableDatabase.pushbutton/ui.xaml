<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GPC - Cable Database Maintenance" Height="480" Width="550"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5F6F8">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="6" Padding="15,10" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="CABLE DATABASE MAINTENANCE" Foreground="#F59E0B" FontSize="15" FontWeight="Bold"/>
                <TextBlock Text="Manage available cable sizes and inspect active model usage." Foreground="#FFFFFF" FontSize="11" Margin="0,4,0,0" Opacity="0.8"/>
            </StackPanel>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>

            <!-- Cable List -->
            <Grid Grid.Column="0" Margin="0,0,15,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Available Cable Types:" FontSize="12" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
                <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Background="White">
                    <ListBox x:Name="lstCableTypes" BorderThickness="0" Padding="5" FontSize="12" SelectionMode="Single"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Padding="8,4" Margin="2" FontWeight="SemiBold" Foreground="#1E293B"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- Actions Sidebar -->
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <TextBlock Text="Database Actions:" FontSize="12" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
                
                <Button x:Name="btnAdd" Content="+ Add Cable" Click="Add_Click" 
                        Height="35" Margin="0,0,0,10" Background="#10B981" Foreground="White" BorderThickness="0" FontWeight="Bold"/>

                <Button x:Name="btnRename" Content="✎ Rename / Replace" Click="Rename_Click" 
                        Height="35" Margin="0,0,0,10" Background="#F59E0B" Foreground="White" BorderThickness="0" FontWeight="Bold"/>

                <Button x:Name="btnDelete" Content="🗑 Delete Unused" Click="Delete_Click" 
                        Height="35" Margin="0,0,0,25" Background="#EF4444" Foreground="White" BorderThickness="0" FontWeight="Bold"/>

                <Button x:Name="btnClose" Content="Close" Click="Close_Click" 
                        Height="35" Background="#E2E8F0" Foreground="#334155" BorderThickness="0" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
