<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GPC - Cable Quantity Takeoff" Height="620" Width="720"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#F8FAFC">
    <Window.Resources>
        <!-- Premium Modern Styles -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Arial, sans-serif"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Segoe UI, Arial, sans-serif"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI, Arial, sans-serif"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Controls Card (Scope, Grouping, Unit) -->
            <RowDefinition Height="Auto"/> <!-- Search Box -->
            <RowDefinition Height="*"/>    <!-- DataGrid -->
            <RowDefinition Height="Auto"/> <!-- Footer / Action Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="6" Padding="15,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="CABLE QUANTITY TAKEOFF" Foreground="#F59E0B" FontSize="15" FontWeight="Bold"/>
                    <TextBlock Text="Summarize and calculate total cable lengths from conduit systems" Foreground="#FFFFFF" FontSize="11" Margin="0,4,0,0" Opacity="0.8"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="lblStatusSummary" Text="Conduits: 0" Foreground="#F1F5F9" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
            </Grid>
        </Border>

        <!-- Controls Card (Scope, Grouping, Unit) -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Scope Section -->
                    <ColumnDefinition Width="*"/>    <!-- Grouping Section -->
                    <ColumnDefinition Width="Auto"/> <!-- Unit Section -->
                </Grid.ColumnDefinitions>

                <!-- Scope Section -->
                <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,20,0">
                    <TextBlock Text="SCOPE" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Height="24">
                        <RadioButton x:Name="rbSelection" Content="Active Selection" IsChecked="True" Checked="Filter_Changed"/>
                        <RadioButton x:Name="rbModel" Content="Entire Model" Checked="Filter_Changed"/>
                    </StackPanel>
                </StackPanel>

                <!-- Grouping Section -->
                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="10,0,10,0" HorizontalAlignment="Stretch">
                    <TextBlock Text="GROUP BY" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Height="24">
                        <RadioButton x:Name="rbGroupBoth" Content="Circuit &amp; Cable Type" IsChecked="True" Checked="Filter_Changed"/>
                        <RadioButton x:Name="rbGroupCable" Content="Cable Type Only" Checked="Filter_Changed"/>
                        <RadioButton x:Name="rbGroupCircuit" Content="Circuit Only" Checked="Filter_Changed"/>
                    </StackPanel>
                </StackPanel>

                <!-- Unit Section -->
                <StackPanel Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Right">
                    <TextBlock Text="LENGTH UNIT" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Height="24">
                        <RadioButton x:Name="rbMeters" Content="Meters (m)" IsChecked="True" Checked="Filter_Changed"/>
                        <RadioButton x:Name="rbFeet" Content="Feet (ft)" Checked="Filter_Changed"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search Box -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Foreground="#94A3B8" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" x:Name="txtSearch" Background="Transparent" BorderThickness="0" 
                         VerticalAlignment="Center" FontSize="12" Foreground="#1E293B" 
                         TextChanged="Search_Changed"/>
                <TextBlock Grid.Column="2" x:Name="lblSearchPlaceholder" Text="Filter by Circuit or Cable Type..." 
                           Foreground="#94A3B8" FontStyle="Italic" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=txtSearch, Path=Text}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="5" Margin="0,0,0,12">
            <Grid>
                <DataGrid x:Name="dgTakeoff" AutoGenerateColumns="False" IsReadOnly="True" 
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                          Background="White" BorderThickness="0" RowHeaderWidth="0" FontSize="12"
                          AlternatingRowBackground="#F8FAFC" RowBackground="White">
                    <DataGrid.Resources>
                        <!-- Column Header Style -->
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Height" Value="34"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                        <!-- Cell Style -->
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Foreground" Value="#1E293B"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E2E8F0"/>
                                    <Setter Property="Foreground" Value="#1E293B"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                </DataGrid>
                <TextBlock x:Name="lblNoData" Text="No cables found in the current selection scope." 
                           Foreground="#94A3B8" FontSize="13" FontStyle="Italic" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Footer / Action Buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="btnExport" Content="💾 Export to CSV" Click="Export_Click"
                    Width="140" Background="#10B981" Foreground="White"/>
            <Button Grid.Column="1" x:Name="btnCopy" Content="📋 Copy to Clipboard" Click="Copy_Click"
                    Width="160" Margin="10,0,0,0" Background="#F59E0B" Foreground="White"/>
            <Button Grid.Column="3" x:Name="btnClose" Content="Close" Click="Close_Click"
                    Width="90" Background="#1E293B" Foreground="White"/>
        </Grid>
    </Grid>
</Window>
