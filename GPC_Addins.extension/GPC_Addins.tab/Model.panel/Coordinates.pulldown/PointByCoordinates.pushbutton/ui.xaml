<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Point by Coordinates" Height="250" Width="350"

        WindowStartupLocation="CenterScreen" Topmost="True" ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="East (X):" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox x:Name="txtEast" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,5" Padding="5"/>

        <Label Grid.Row="1" Grid.Column="0" Content="North (Y):" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox x:Name="txtNorth" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,5" Padding="5"/>

        <Label Grid.Row="2" Grid.Column="0" Content="Radius (m):" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox x:Name="txtRadius" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="0,5" Padding="5" Text="0.1"/>

        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" VerticalAlignment="Bottom">
            <Button x:Name="btnCancel" Content="Cancel" Width="80" Height="30" Margin="0,0,10,0" Click="Cancel_Click" Background="#E0E0E0" BorderBrush="{x:Null}"/>
            <Button x:Name="btnPlot" Content="Plot Point" Width="100" Height="30" Click="Plot_Click" Background="#2196F3" Foreground="White" BorderBrush="{x:Null}" FontWeight="Bold"/>
        </StackPanel>

    </Grid>
</Window>
