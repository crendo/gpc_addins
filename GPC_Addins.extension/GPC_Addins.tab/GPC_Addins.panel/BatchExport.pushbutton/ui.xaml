<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Export Sheets" Height="500" Width="450" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Group Length n -->
            <RowDefinition Height="Auto"/> <!-- Dropdown -->
            <RowDefinition Height="Auto"/> <!-- Folder Picker -->
            <RowDefinition Height="Auto"/> <!-- Prefix -->
            <RowDefinition Height="Auto"/> <!-- Export Options -->
            <RowDefinition Height="*"/>    <!-- Sheet List -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>
        
        <!-- Row 0: Group Length -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Grouping characters (n):" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="GroupLengthInput" Width="50" Text="2" TextChanged="OnGroupLengthChanged" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- Row 1: Group Dropdown -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Select Sheet Group:" VerticalAlignment="Center" Margin="0,0,10,0" Width="130"/>
            <ComboBox x:Name="GroupDropdown" Width="200" SelectionChanged="OnGroupSelectionChanged"/>
        </StackPanel>

        <!-- Row 2: Export Folder -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="Browse..." Width="80" Click="OnBrowseFolderClick"/>
            <TextBlock x:Name="FolderPathText" Text="Select export destination..." VerticalAlignment="Center" Margin="10,0,0,0" FontStyle="Italic"/>
        </StackPanel>

        <!-- Row 3: Prefix -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="File Prefix:" VerticalAlignment="Center" Margin="0,0,10,0" Width="130"/>
            <TextBox x:Name="PrefixInput" Width="200" Text="" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- Row 4: Export Formats -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Export Formats:" VerticalAlignment="Center" Margin="0,0,10,0" Width="130"/>
            <CheckBox x:Name="ExportPdfCheckbox" Content="PDF" IsChecked="True" Margin="0,0,15,0" VerticalAlignment="Center"/>
            <CheckBox x:Name="ExportDwgCheckbox" Content="DWG" IsChecked="False" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Row 5: Sheet List -->
        <GroupBox Grid.Row="5" Header="Select Sheets" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <CheckBox x:Name="SelectAllCheckbox" Content="Select All" IsChecked="True" Margin="5,5,5,5" Checked="OnSelectAllChecked" Unchecked="OnSelectAllUnchecked"/>
                <ListBox Grid.Row="1" x:Name="SheetListBox" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,5,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2,4,2,4"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </GroupBox>

        <!-- Row 6: Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Export" Width="90" Height="30" Margin="0,0,10,0" Click="OnExportClick" IsDefault="True"/>
            <Button Content="Cancel" Width="90" Height="30" Click="OnCancelClick" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
