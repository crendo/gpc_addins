<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GPC - Project Circuit Database Manager" Height="680" Width="820"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#F8FAFC">
    <DockPanel Margin="15" LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="#1E293B" CornerRadius="6" Padding="15,12" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="PROJECT CIRCUIT DATABASE MANAGER" Foreground="#F59E0B" FontSize="16" FontWeight="Bold"></TextBlock>
                <TextBlock Text="Manage, search, add, or delete circuits for the entire project. Changes are saved directly to the project's circuit database." Foreground="#FFFFFF" FontSize="11" Margin="0,4,0,0" Opacity="0.8"></TextBlock>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="#E2E8F0" Padding="0,15,0,0" Margin="0,10,0,0">
            <DockPanel LastChildFill="False">
                <Button x:Name="btnSaveClose" Content="Save &amp; Close" Click="SaveClose_Click" DockPanel.Dock="Right" Width="130" Height="35" Background="#10B981" Foreground="White" BorderThickness="0" FontWeight="Bold"></Button>
                <Button x:Name="btnSave" Content="Save to Database" Click="Save_Click" DockPanel.Dock="Right" Width="150" Height="35" Margin="0,0,12,0" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="Bold"></Button>
                <Button x:Name="btnCancel" Content="Cancel" Click="Cancel_Click" DockPanel.Dock="Right" Width="100" Height="35" Margin="0,0,12,0" Background="#E2E8F0" Foreground="#334155" BorderThickness="0"></Button>
            </DockPanel>
        </Border>

        <DockPanel DockPanel.Dock="Left" Width="320" Margin="0,0,15,0">
            <Border DockPanel.Dock="Top" BorderThickness="1" BorderBrush="#E2E8F0" CornerRadius="6" Padding="4" Margin="0,0,0,10" Background="White">
                <Grid>
                    <TextBox x:Name="txtSearch" BorderThickness="0" Background="Transparent" Padding="5,4" FontSize="12" TextChanged="Search_TextChanged"></TextBox>
                    <TextBlock x:Name="lblSearchPlaceholder" IsHitTestVisible="False" Text="Search circuits..." VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" Foreground="#94A3B8" Visibility="Visible"></TextBlock>
                </Grid>
            </Border>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Button x:Name="btnAddCircuit" Content="+ Add Circuit" Click="AddCircuit_Click" Height="32" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="Bold" Margin="0,0,0,8"></Button>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnScrubCircuit" Content="Scrub Model" Click="ScrubCircuit_Click" Grid.Column="0" Height="32" Background="#F59E0B" Foreground="White" BorderThickness="0" FontWeight="Bold"></Button>
                    <Button x:Name="btnDeleteCircuit" Content="Delete Circuit" Click="DeleteCircuit_Click" Grid.Column="2" Height="32" Background="#EF4444" Foreground="White" BorderThickness="0" FontWeight="Bold"></Button>
                </Grid>
            </StackPanel>

            <Border BorderThickness="1" BorderBrush="#E2E8F0" CornerRadius="6" Background="White" Padding="2">
                <ListBox x:Name="lstCircuits" BorderThickness="0" SelectionChanged="Circuits_SelectionChanged" DisplayMemberPath="Name">
                </ListBox>
            </Border>
        </DockPanel>

        <Border BorderThickness="1" BorderBrush="#E2E8F0" Background="White" CornerRadius="6" Padding="20">
            <Grid>
                <Grid x:Name="gridEmptyState" Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="No Circuit Selected" FontSize="14" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"></TextBlock>
                        <TextBlock Text="Select a circuit from the left list to view or edit its details." FontSize="11" Foreground="#94A3B8" Margin="0,5,0,0" HorizontalAlignment="Center"></TextBlock>
                    </StackPanel>
                </Grid>

                <DockPanel x:Name="gridEditor" Visibility="Collapsed" LastChildFill="True">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                        <TextBlock Text="Circuit Name:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#334155" DockPanel.Dock="Left"></TextBlock>
                        <TextBox x:Name="txtCircuitName" Padding="5" VerticalAlignment="Center" LostFocus="CircuitName_LostFocus"></TextBox>
                    </DockPanel>

                    <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="#E2E8F0" Padding="0,0,0,8" Margin="0,0,0,10">
                        <TextBlock Text="Phase and Cable Configurations" FontWeight="Bold" FontSize="13" Foreground="#475569"></TextBlock>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="panelPhaseEditors">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Phase" Width="110" FontWeight="Bold" FontSize="11" Foreground="#64748B"></TextBlock>
                                <TextBlock Text="Qty / Count" Width="80" FontWeight="Bold" FontSize="11" Foreground="#64748B"></TextBlock>
                                <TextBlock Text="Cable Type" Width="180" FontWeight="Bold" FontSize="11" Foreground="#64748B"></TextBlock>
                                <TextBlock Text="Shared" Width="60" FontWeight="Bold" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"></TextBlock>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4" Height="30">
                                <TextBlock Text="Phase 1" Width="110" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"></TextBlock>
                                <TextBox x:Name="txtQty_Phase1" Text="1" Width="60" Margin="0,0,20,0" Padding="4" VerticalAlignment="Center"></TextBox>
                                <ComboBox x:Name="cbCable_Phase1" Width="170" Margin="0,0,20,0" VerticalAlignment="Center"></ComboBox>
                                <CheckBox x:Name="chkShared_Phase1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0,0,0"></CheckBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4" Height="30">
                                <TextBlock Text="Phase 2" Width="110" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"></TextBlock>
                                <TextBox x:Name="txtQty_Phase2" Text="1" Width="60" Margin="0,0,20,0" Padding="4" VerticalAlignment="Center"></TextBox>
                                <ComboBox x:Name="cbCable_Phase2" Width="170" Margin="0,0,20,0" VerticalAlignment="Center"></ComboBox>
                                <CheckBox x:Name="chkShared_Phase2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0,0,0"></CheckBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4" Height="30">
                                <TextBlock Text="Phase 3" Width="110" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"></TextBlock>
                                <TextBox x:Name="txtQty_Phase3" Text="1" Width="60" Margin="0,0,20,0" Padding="4" VerticalAlignment="Center"></TextBox>
                                <ComboBox x:Name="cbCable_Phase3" Width="170" Margin="0,0,20,0" VerticalAlignment="Center"></ComboBox>
                                <CheckBox x:Name="chkShared_Phase3" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0,0,0"></CheckBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4" Height="30">
                                <TextBlock Text="Neutral" Width="110" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"></TextBlock>
                                <TextBox x:Name="txtQty_Neutral" Text="1" Width="60" Margin="0,0,20,0" Padding="4" VerticalAlignment="Center"></TextBox>
                                <ComboBox x:Name="cbCable_Neutral" Width="170" Margin="0,0,20,0" VerticalAlignment="Center"></ComboBox>
                                <CheckBox x:Name="chkShared_Neutral" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0,0,0"></CheckBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4" Height="30">
                                <TextBlock Text="Ground" Width="110" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"></TextBlock>
                                <TextBox x:Name="txtQty_Ground" Text="1" Width="60" Margin="0,0,20,0" Padding="4" VerticalAlignment="Center"></TextBox>
                                <ComboBox x:Name="cbCable_Ground" Width="170" Margin="0,0,20,0" VerticalAlignment="Center"></ComboBox>
                                <CheckBox x:Name="chkShared_Ground" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0,0,0"></CheckBox>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>
    </DockPanel>
</Window>
