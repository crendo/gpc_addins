<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Line by Coordinates" Height="380" Width="400"

        WindowStartupLocation="CenterScreen" Topmost="True" ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Start Point" FontWeight="Bold" Margin="0,0,0,5"/>
        
        <Label Grid.Row="1" Grid.Column="0" Content="Start East (X1):" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox x:Name="txtEast1" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,5" Padding="5"/>

        <Label Grid.Row="2" Grid.Column="0" Content="Start North (Y1):" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox x:Name="txtNorth1" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="0,5" Padding="5"/>

        <Separator Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Text="End Point" FontWeight="Bold" Margin="0,0,0,5"/>

        <Label Grid.Row="5" Grid.Column="0" Content="End East (X2):" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox x:Name="txtEast2" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" Margin="0,5" Padding="5"/>

        <Label Grid.Row="6" Grid.Column="0" Content="End North (Y2):" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox x:Name="txtNorth2" Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" Margin="0,5" Padding="5"/>

        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" VerticalAlignment="Bottom">
            <Button x:Name="btnCancel" Content="Cancel" Width="80" Height="30" Margin="0,0,10,0" Click="Cancel_Click" Background="#E0E0E0" BorderBrush="{x:Null}"/>
            <Button x:Name="btnPlot" Content="Draw Line" Width="100" Height="30" Click="Plot_Click" Background="#4CAF50" Foreground="White" BorderBrush="{x:Null}" FontWeight="Bold"/>
        </StackPanel>

    </Grid>
</Window>
