<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GPC - Identify &amp; Highlight Circuit" Height="540" Width="720"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F8FAFC" Topmost="True" FontFamily="Segoe UI">
    <DockPanel Margin="15" LastChildFill="True">
        <!-- Top Header -->
        <Border DockPanel.Dock="Top" Background="#1E293B" CornerRadius="6" Padding="15,12" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="IDENTIFY &amp; HIGHLIGHT CIRCUIT" Foreground="#F59E0B" FontSize="16" FontWeight="Bold"></TextBlock>
                <TextBlock Text="Select a circuit to automatically locate, highlight in color, and select all its conduits and fittings in the active view." Foreground="#FFFFFF" FontSize="11" Margin="0,4,0,0" Opacity="0.8"></TextBlock>
            </StackPanel>
        </Border>

        <!-- Bottom Action Bar -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="#E2E8F0" Padding="0,15,0,0" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Button x:Name="btnClear" Grid.Column="0" Content="Clear Highlights" Click="Clear_Click" Width="140" Height="35" Background="#EF4444" Foreground="White" BorderThickness="0" FontWeight="Bold"></Button>
                <Button x:Name="btnClose" Grid.Column="2" Content="Close" Click="Close_Click" Width="80" Height="35" Margin="0,0,10,0" Background="#E2E8F0" Foreground="#334155" BorderThickness="0"></Button>
                <Button x:Name="btnHighlight" Grid.Column="3" Content="Highlight &amp; Select" Click="Highlight_Click" Width="170" Height="35" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="Bold"></Button>
            </Grid>
        </Border>

        <!-- Left Search & Circuit List Column -->
        <DockPanel DockPanel.Dock="Left" Width="280" Margin="0,0,15,0">
            <!-- Search Box -->
            <Border DockPanel.Dock="Top" BorderThickness="1" BorderBrush="#E2E8F0" CornerRadius="6" Padding="4" Margin="0,0,0,10" Background="White">
                <Grid>
                    <TextBox x:Name="txtSearch" BorderThickness="0" Background="Transparent" Padding="5,4" FontSize="12" TextChanged="Search_TextChanged"></TextBox>
                    <TextBlock x:Name="lblSearchPlaceholder" IsHitTestVisible="False" Text="Search circuits..." VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" Foreground="#94A3B8" Visibility="Visible"></TextBlock>
                </Grid>
            </Border>

            <!-- Circuit ListBox -->
            <Border BorderThickness="1" BorderBrush="#E2E8F0" CornerRadius="6" Background="White" Padding="2">
                <ListBox x:Name="lstCircuits" BorderThickness="0" SelectionChanged="Circuits_SelectionChanged" DisplayMemberPath="DisplayName">
                </ListBox>
            </Border>
        </DockPanel>

        <!-- Right Configuration Column -->
        <Border BorderThickness="1" BorderBrush="#E2E8F0" Background="White" CornerRadius="6" Padding="20">
            <Grid>
                <!-- Empty State (when no circuit selected) -->
                <Grid x:Name="gridEmptyState" Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="No Circuit Selected" FontSize="14" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"></TextBlock>
                        <TextBlock Text="Select a circuit from the left list to enable highlighting settings." FontSize="11" Foreground="#94A3B8" Margin="0,5,0,0" HorizontalAlignment="Center"></TextBlock>
                    </StackPanel>
                </Grid>

                <!-- Active Editor / Settings State -->
                <DockPanel x:Name="gridSettings" Visibility="Collapsed" LastChildFill="True">
                    <!-- Circuit Summary Header -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                        <TextBlock x:Name="txtSelectedName" Text="CIRCUIT DETAIL" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                        <TextBlock x:Name="txtSummaryInfo" Text="Select styling preferences below to highlight this circuit." FontSize="11" Foreground="#64748B"/>
                    </StackPanel>

                    <!-- Divider -->
                    <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="#E2E8F0" Padding="0,0,0,8" Margin="0,0,0,15">
                        <TextBlock Text="Visual Override Settings" FontWeight="Bold" FontSize="12" Foreground="#475569"></TextBlock>
                    </Border>

                    <!-- Form Settings -->
                    <StackPanel>
                        <!-- Color Dropdown -->
                        <TextBlock Text="Highlight Color:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cbColor" Height="32" Padding="8,4" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" Margin="0,0,0,20"/>

                        <!-- Line Weight Slider -->
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Line Weight Override (1-16):" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="lblWeightVal" Text="8" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </Grid>
                        <Slider x:Name="sliderWeight" Minimum="1" Maximum="16" Value="8" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="0,0,0,20"/>

                        <!-- Extra Details Border -->
                        <Border Background="#F1F5F9" CornerRadius="6" Padding="12" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Quick Summary:" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,6"/>
                                <TextBlock x:Name="lblDetailsText" Text="Detail text goes here..." FontSize="11" Foreground="#334155" TextWrapping="Wrap" LineHeight="16"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </DockPanel>
</Window>
